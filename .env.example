# Use only a separate local/test database here. Never copy production patient data.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Generate unique values for every environment. Do not reuse production secrets.
ADMIN_PASSWORD=replace-with-a-strong-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
ADMIN_ENCRYPTION_KEY=replace-with-at-least-32-different-random-bytes
CRON_SECRET=replace-with-at-least-32-more-random-bytes

MAX_REMINDERS_PER_RUN=25
REMINDER_GRACE_DAYS=7

# ivoris REST API v2 remains deliberately disabled until the vendor contract,
# authentication method and endpoint documentation have been reviewed.
# Do not invent or pre-create credential variables and never use production
# ivoris credentials in Preview/Development.
